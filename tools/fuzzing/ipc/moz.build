Library("fuzzer-ipc-protocol")

LOCAL_INCLUDES += [
    "/dom/base",
    "/dom/ipc",
    "/tools/fuzzing/ipc/protobuf",
]

SOURCES += [
    "IPCFuzzController.cpp",
    "LibprotobufMapping.cpp",
    "protobuf/SetCharacterMap.pb.cc",
    "protobuf/test.pb.cc",
]

EXPORTS.mozilla.fuzzing += [
    "IPCFuzzController.h",
    "LibprotobufMapping.h",
    "protobuf/SetCharacterMap.pb.h",
    "protobuf/test.pb.h",
]

include("/ipc/chromium/chromium-config.mozbuild")

FINAL_LIBRARY = "xul"

# Add libFuzzer configuration directives
include("/tools/fuzzing/libfuzzer-config.mozbuild")
